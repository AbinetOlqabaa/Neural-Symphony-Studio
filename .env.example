# GEMINI_API_KEY: Required for server-side Gemini AI calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional server-side default Gemini model (e.g. gemini-4-hydrogen or gemini-3.1-flash-lite)
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional external ComfyUI GPU backend configuration (server-side)
COMFYUI_SERVER_URL=""
COMFYUI_API_TOKEN=""
COMFYUI_TIMEOUT_MS="8000"

# Optional external Qwen2.5-VL-3B-Instruct OpenAI-compatible inference backend
QWEN_VL_ENDPOINT_URL=""
QWEN_VL_API_KEY=""
QWEN_VL_MODEL_ID="Qwen/Qwen2.5-VL-3B-Instruct"

# Optional external FFmpeg render worker URL (leave blank to use local FFmpeg)
FFMPEG_RENDER_SERVICE_URL=""

# Optional multi-provider AI orchestration backends (server-side only, never exposed to client)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://127.0.0.1:11434"
CUSTOM_OPENAI_COMPATIBLE_URL=""
CUSTOM_OPENAI_COMPATIBLE_KEY=""

